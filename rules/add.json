{
  "problem": "add_two_integers",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "sample_input": "tests/add/01.in",
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.20,
      "params": { "testset_dir": "tests/add/" }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.10,
      "params": { "flags": "-Wall -Wextra -Werror -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": { "max_cyclomatic": 8, "max_function_length": 40 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2 }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.10,
      "params": { "cases": ["negatives", "zero", "int_overflow"],
                  "reference": "reference/add.c", "random_per_case": 3, "seed": 42 }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.10,
      "params": { "required": "O(1)", "sizes": [1000000, 10000000, 100000000],
                  "input": "{n} {n}" }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.10,
      "params": { "flags": "-fsanitize=address,undefined", "inputs_dir": "tests/add/" }
    },
    {
      "name": "readability",
      "analyzer": "readability_rules",
      "weight": 0.10,
      "params": { "min_comment_ratio": 0.1, "min_name_length": 2, "max_line_length": 80 }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.10,
      "params": { "corpus_dir": "submissions/", "flag_threshold": 0.85 }
    }
  ]
}
